# Hybrid AI Options Platform - Environment Configuration

# Application & API
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=dev-secret-key-change-in-production
API_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
DEFAULT_OPERATING_MODE=recommendation

# Database
# For SQLite (default offline dev/CI):
DATABASE_URL=sqlite:///./platform.db
# For PostgreSQL / TimescaleDB:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/options_platform

# Market Data Ingestion
DERIBIT_LIVE_ENABLED=false
DERIBIT_WS_URL=wss://www.deribit.com/ws/api/v2
DERIBIT_HTTP_URL=https://www.deribit.com/api/v2
MARKET_DATA_REPLAY_FILE=data/samples/btc_options_sample.parquet

# Quantitative & Risk Limits
DEFAULT_UNDERLYING=BTC
MAX_DELTA_LIMIT=5.0
MAX_VEGA_LIMIT=50000.0
MAX_VAR_LIMIT=100000.0
MAX_DRAWDOWN_LIMIT_PCT=0.15
MIN_EDGE_THRESHOLD=0.015

# Safety Guard: Live trading is strictly disabled in Milestone 1
LIVE_TRADING_ENABLED=false
